{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dnd_skill/spells.schema.json",
  "title": "PHB 5e structured spell catalog",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name_zh",
      "name_en",
      "level",
      "school",
      "school_zh",
      "ritual",
      "source_page",
      "classes",
      "types",
      "cooldown_rounds",
      "concentration",
      "duration",
      "damage_calculation",
      "healing_calculation"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
      },
      "name_zh": {
        "type": "string",
        "minLength": 1
      },
      "name_en": {
        "type": "string",
        "minLength": 1
      },
      "level": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9
      },
      "school": {
        "enum": [
          "abjuration",
          "conjuration",
          "divination",
          "enchantment",
          "evocation",
          "illusion",
          "necromancy",
          "transmutation"
        ]
      },
      "school_zh": {
        "enum": [
          "防护",
          "咒法",
          "预言",
          "附魔",
          "塑能",
          "幻术",
          "死灵",
          "变化"
        ]
      },
      "ritual": {
        "type": "boolean"
      },
      "source_page": {
        "type": "integer",
        "minimum": 1
      },
      "classes": {
        "type": "array",
        "items": {
          "enum": [
            "bard",
            "cleric",
            "druid",
            "paladin",
            "ranger",
            "sorcerer",
            "warlock",
            "wizard"
          ]
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "types": {
        "type": "array",
        "items": {
          "enum": [
            "damage",
            "healing",
            "control",
            "defense",
            "buff",
            "mobility",
            "summoning",
            "exploration"
          ]
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "cooldown_rounds": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9
      },
      "concentration": {
        "type": "boolean"
      },
      "duration": {
        "type": "string"
      },
      "damage_calculation": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "base": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "method": {
            "type": "string"
          },
          "on_save": {
            "type": [
              "string",
              "null"
            ]
          },
          "scaling": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "base",
          "scaling",
          "details"
        ],
        "additionalProperties": false
      },
      "healing_calculation": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "base": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "method": {
            "type": "string"
          },
          "on_save": {
            "type": [
              "string",
              "null"
            ]
          },
          "scaling": {
            "type": [
              "string",
              "null"
            ]
          },
          "details": {
            "type": "string"
          }
        },
        "required": [
          "base",
          "scaling",
          "details"
        ],
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
