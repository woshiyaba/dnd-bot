page {
  min-height: 100%;
  background: #f5f7f4;
  color: #17201e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 30rpx;
}

button {
  margin: 0;
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.25;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.primary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 20rpx 32rpx;
  background: #226a5a;
  color: #fff;
  font-weight: 600;
}

.secondary-button {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  padding: 20rpx 32rpx;
  background: #fff;
  color: #226a5a;
  border: 2rpx solid #c6d5d0;
  font-weight: 600;
}

.muted {
  color: #66716e;
}

.eyebrow {
  color: #226a5a;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.section-title {
  margin: 0;
  font-size: 34rpx;
  font-weight: 700;
}
