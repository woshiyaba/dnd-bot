.sheet {
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #d8deda;
  background: #fff;
  box-shadow: 0 -16rpx 40rpx rgba(23, 32, 30, 0.08);
}

.sheet-title {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.sheet-title > view {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.kicker {
  color: #b67820;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.title {
  color: #17201e;
  font-size: 32rpx;
  font-weight: 700;
}

.actor,
.dice-label {
  padding: 10rpx 16rpx;
  border-radius: 12rpx;
  background: #f1f4f2;
  color: #66716e;
  font-size: 23rpx;
}

.prompt {
  display: block;
  margin: 18rpx 0 22rpx;
  color: #4d5a56;
  font-size: 27rpx;
  line-height: 1.55;
}

.action-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.action-button {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 84rpx;
  padding: 18rpx 22rpx;
  background: #f1f4f2;
  color: #17201e;
  font-size: 27rpx;
  text-align: left;
}

.action-primary {
  background: #226a5a;
  color: #fff;
}

.action-muted {
  color: #66716e;
}

.action-detail {
  margin-left: 16rpx;
  font-size: 21rpx;
  opacity: 0.72;
}

.roll-result {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  min-height: 150rpx;
}

.dice-shape {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 108rpx;
  height: 108rpx;
  transform: rotate(45deg);
  border: 4rpx solid #5867a8;
  border-radius: 20rpx;
  background: #eff1fb;
  color: #3e4e92;
  font-size: 38rpx;
  font-weight: 800;
}

.dice-shape text {
  transform: rotate(-45deg);
}

.roll-result-visible .dice-shape {
  animation: settle 0.72s ease-out;
}

.formula {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  color: #17201e;
  font-size: 28rpx;
  font-variant-numeric: tabular-nums;
}

.bonus {
  color: #66716e;
  font-size: 23rpx;
}

.roll-actions,
.manual-row {
  display: flex;
  gap: 16rpx;
}

.roll-actions button,
.manual-row button {
  min-height: 84rpx;
  flex: 1;
  padding: 18rpx;
  font-size: 27rpx;
}

.virtual-button {
  background: #5867a8;
  color: #fff;
}

.manual-button {
  background: #f1f4f2;
  color: #3f4d49;
}

.manual-row {
  margin-top: 16rpx;
}

.manual-row input {
  width: 180rpx;
  min-height: 80rpx;
  padding: 0 22rpx;
  box-sizing: border-box;
  border: 2rpx solid #d8deda;
  border-radius: 12rpx;
  text-align: center;
}

.manual-row button {
  background: #226a5a;
  color: #fff;
}

@keyframes settle {
  0% { transform: rotate(45deg) scale(0.75); }
  55% { transform: rotate(405deg) scale(1.08); }
  100% { transform: rotate(405deg) scale(1); }
}
