.home {
  padding-top: 54rpx;
}

.brand-row,
.section-heading,
.hero-topline,
.campaign-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.brand-row > view:first-child {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.brand-title {
  font-size: 46rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: #dce9e5;
  color: #226a5a;
  font-weight: 700;
}

.recent-section {
  margin-top: 58rpx;
}

.section-label {
  display: block;
  margin-bottom: 18rpx;
  color: #66716e;
  font-size: 25rpx;
  font-weight: 600;
}

.hero-card {
  overflow: hidden;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 18rpx 50rpx rgba(33, 55, 49, 0.1);
}

.hero-art {
  position: relative;
  height: 230rpx;
  overflow: hidden;
  background: linear-gradient(165deg, #243f48, #31443d 60%, #182421);
}

.moon {
  position: absolute;
  width: 92rpx;
  height: 92rpx;
  right: 90rpx;
  top: 38rpx;
  border-radius: 50%;
  background: #f0ddb4;
  box-shadow: 0 0 70rpx rgba(240, 221, 180, 0.45);
}

.tower {
  position: absolute;
  width: 110rpx;
  height: 190rpx;
  right: 150rpx;
  bottom: -30rpx;
  transform: skew(-2deg);
  background: #14201d;
  box-shadow: -190rpx 70rpx 0 30rpx #172522, 160rpx 60rpx 0 15rpx #172522;
}

.tower::before {
  content: "";
  position: absolute;
  left: 38rpx;
  top: 35rpx;
  width: 34rpx;
  height: 48rpx;
  border-radius: 18rpx 18rpx 0 0;
  background: #d29d4c;
}

.hero-content {
  padding: 26rpx;
}

.hero-topline {
  color: #66716e;
  font-size: 22rpx;
}

.hero-topline text:first-child {
  color: #b67820;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 750;
}

.hero-location {
  display: block;
  margin-top: 8rpx;
  color: #66716e;
  font-size: 25rpx;
}

.continue-button {
  min-height: 82rpx;
  margin-top: 24rpx;
  background: #226a5a;
  color: #fff;
  font-size: 28rpx;
  font-weight: 650;
}

.intro {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 62rpx;
  padding: 38rpx 34rpx;
  border-left: 8rpx solid #5867a8;
  background: #fff;
}

.intro-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.45;
}

.intro-copy {
  color: #66716e;
  font-size: 27rpx;
  line-height: 1.6;
}

.campaign-section {
  margin-top: 52rpx;
}

.section-heading {
  margin-bottom: 20rpx;
}

.section-heading .muted {
  font-size: 23rpx;
}

.campaign-row {
  gap: 22rpx;
  padding: 26rpx 0;
  border-top: 2rpx solid #d8deda;
  border-bottom: 2rpx solid #d8deda;
}

.campaign-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  min-width: 96rpx;
  height: 112rpx;
  border-radius: 14rpx;
  background: linear-gradient(145deg, #5867a8, #3f486f);
  color: #fff;
  font-size: 38rpx;
  font-weight: 800;
}

.campaign-info {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.campaign-title {
  font-size: 30rpx;
  font-weight: 700;
}

.campaign-copy {
  overflow: hidden;
  color: #66716e;
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag-row {
  display: flex;
  gap: 12rpx;
  color: #226a5a;
  font-size: 20rpx;
}

.arrow {
  color: #8b9692;
  font-size: 52rpx;
}
