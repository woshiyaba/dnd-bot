# 可选的部署区域标识
REGION=

# OpenAI 兼容模型供应商目录
LLM_PROVIDERS=deepseek
LLM_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_PROVIDER_DEEPSEEK_API_KEY=sk-xxxxx

# 模型使用「供应商/上游模型 ID」复合名；项目启动时会初始化目录中的全部客户端
LLM_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash
LLM_REASONING_MODEL=deepseek/deepseek-v4-pro
LLM_FAST_MODEL=deepseek/deepseek-v4-flash

# 可选：按职责覆盖 Pro / Flash 默认分层
# DM_DECISION_MODEL=deepseek/deepseek-v4-pro
# DM_GUIDANCE_MODEL=deepseek/deepseek-v4-flash
# DM_TRIGGER_MODEL=deepseek/deepseek-v4-flash
# DM_NARRATION_MODEL=deepseek/deepseek-v4-flash
# COMBAT_DECISION_MODEL=deepseek/deepseek-v4-flash
# COMBAT_NARRATION_MODEL=deepseek/deepseek-v4-flash
# ACTION_COMPILER_MODEL=deepseek/deepseek-v4-flash
# STORY_INTERVIEW_MODEL=deepseek/deepseek-v4-flash
# STORY_AUTHORING_MODEL=deepseek/deepseek-v4-pro
# STORY_REPAIR_MODEL=deepseek/deepseek-v4-pro
# LEGACY_AGENT_MODEL=deepseek/deepseek-v4-flash

# 可选：接入 DashScope / Qwen
# 启用时将上方两个目录变量改为以下内容，并配置连接参数
# LLM_PROVIDERS=deepseek,dashscope
# LLM_MODELS=deepseek/deepseek-v4-pro,deepseek/deepseek-v4-flash,dashscope/qwen3.5-plus
# LLM_PROVIDER_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_PROVIDER_DASHSCOPE_API_KEY=
# DM_NARRATION_MODEL=dashscope/qwen3.5-plus

# MySQL 数据库配置
MYSQL_HOST=hosts
MYSQL_PORT=3306
MYSQL_DATABASE=xxx
MYSQL_USER=xxx
MYSQL_PASSWORD=xxxx

# 系统提示词缓存秒数，设置为 0 表示每次都查库
PROMPT_CACHE_TTL_SECONDS=30
